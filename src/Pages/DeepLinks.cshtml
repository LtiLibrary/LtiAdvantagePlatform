@page
@using System.Text.Json
@model AdvantagePlatform.Pages.DeepLinksModel
@{
    Layout = null;
    // msg and errormsg come from the tool's deep linking response; the page that started the
    // flow shows them to the user.
    var message = new
    {
        type = "lti-deep-linking-complete",
        added = Model.AddedCount,
        msg = Model.Message,
        errormsg = Model.ErrorMessage
    };
    var origins = new[] { $"{Request.Scheme}://{Request.Host}" }.Concat(Model.MessageTargetOrigins);
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Deep Links Return</title>
</head>
<body>
<p>Added @Model.AddedCount item(s).</p>
@if (!string.IsNullOrWhiteSpace(Model.Message))
{
    <p>@Model.Message</p>
}
@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <p style="color: #b00">@Model.ErrorMessage</p>
}
<script>
    // This page loads inside the iframe that ran the deep linking flow. Tell the page around
    // it (the Razor home page or the React app) that the tool is done, so it can close the
    // iframe and reload its links. postMessage with an explicit target origin only delivers
    // the message when the parent is one of these origins.
    (function () {
        var message = @Html.Raw(JsonSerializer.Serialize(message));
        var origins = @Html.Raw(JsonSerializer.Serialize(origins));
        if (window.parent !== window) {
            origins.forEach(function (origin) { window.parent.postMessage(message, origin); });
        } else {
            // Not in an iframe (e.g. opened in a new tab): go back to the home page, which
            // shows the message (see Components/DeepLinks).
            try { sessionStorage.setItem("ltiDeepLinkingComplete", JSON.stringify(message)); } catch (e) { }
            window.location.href = "/";
        }
    })();
</script>
</body>
</html>
