@using AdvantagePlatform.Utility
@model GradebookViewComponentModel

<div class="row mt-3">
    <div class="col">
        <div class="card bg-transparent">
            <h5 class="card-header">Gradebook</h5>
            <div class="card-body">
                <table class="table table-bordered table-sm border-0">
                    <thead>
                    <tr>
                        <th scope="col" class="border-left-0 border-top-0"></th>
                        @foreach (var column in Model.Columns.OrderBy(c => c.Header))
                        {
                            <th scope="col" class="text-center">
                                @column.Header
                                @* AGS 2.0 gradesReleased: set by the tool, and changeable here. *@
                                <form method="post" asp-page="/Index" asp-page-handler="SetGradesReleased" asp-route-id="@column.Column.Id" class="d-block">
                                    @if (column.Column.ReleasedToLearners)
                                    {
                                        <small class="text-success" data-toggle="tooltip"
                                               title="@(column.Column.GradesReleased == null ? "The tool did not set gradesReleased; this platform shows the grades" : "gradesReleased: true")">
                                            <i class="fas fa-eye"></i> released@(column.Column.GradesReleased == null ? " (default)" : "")
                                        </small>
                                        <button type="submit" name="released" value="false" class="btn btn-link btn-sm p-0 ml-1">hide</button>
                                    }
                                    else
                                    {
                                        <small class="text-muted" data-toggle="tooltip" title="gradesReleased: false">
                                            <i class="fas fa-eye-slash"></i> hidden from learners
                                        </small>
                                        <button type="submit" name="released" value="true" class="btn btn-link btn-sm p-0 ml-1">release</button>
                                    }
                                </form>
                            </th>
                        }
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var personId in Model.Members.Keys)
                    {
                        <tr>
                            <th scope="row">@Model.Members[personId]</th>
                            @foreach (var column in Model.Columns.OrderBy(c => c.Header))
                            {
                                <td class="text-center">
                                    @{
                                        // The grade is the last score that had a value; a later progress-only score
                                        // (no scoreGiven) only updates the progress, as AGS results report it.
                                        var lastScore = column.Column.Scores.LastOrDefault(s => s.PersonId == personId);
                                        var lastGraded = column.Column.Scores.LastOrDefault(s => s.PersonId == personId && s.ScoreGiven.HasValue);
                                    }
                                    @if (lastScore == null)
                                    {
                                        <span data-toggle="tooltip" title="No scores submitted">--</span>
                                    }
                                    else
                                    {
                                        <span data-toggle="tooltip" title="@lastScore.Comment">
                                            @(lastGraded?.ScoreGiven?.ToString("N1") ?? lastScore.ActivityProgress.ToString())
                                        </span>
                                        @* Submission Review: the tool set submissionReview on this line item, so
                                           the instructor can open the student's submission in the tool. *@
                                        @if (column.Column.HasSubmissionReview && column.Column.ResourceLink != null && Model.InstructorId.HasValue)
                                        {
                                            <a class="btn btn-sm btn-light ml-1" target="_blank"
                                               data-toggle="tooltip" title="Launch the tool's submission review for this student"
                                               href="@Url.Page("/OidcLaunch", new
                                                     {
                                                         id = column.Column.Id,
                                                         messageType = LtiAdvantage.Constants.Lti.LtiSubmissionReviewRequestMessageType,
                                                         courseId = Model.CourseId,
                                                         personId = Model.InstructorId,
                                                         forUserId = personId
                                                     })">
                                                @column.Column.SubmissionReviewLabel.IfMissingThen("View submission")
                                            </a>
                                        }
                                    }
                                </td>
                            }
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>